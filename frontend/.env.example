# ==========================================
# NextChapter Frontend Environment Variables
# ==========================================

# Supabase (Database & Authentication)
# Obtain these from: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend AI & RAG Service
VITE_AI_SUGGESTION_URL=http://127.0.0.1:8001
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Razorpay Payments (if enabled)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
